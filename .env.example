# Copy this file to .env and fill in what you have. Everything is optional.
PORT=3000

# AI helper (free): get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Twi & Dagbani machine voice, speech recognition and translation: https://translation.ghananlp.org
KHAYA_API_KEY=

# Protects the research pages (test sessions, Language Studio uploads). Pick any number.
RESEARCH_PIN=

# Keeps "one vote per phone" stable across restarts. Any long random text.
TOKEN_SALT=

# --- Hosting on Vercel: storage ---
# Added for you when you connect "Upstash for Redis" to the Vercel project (Storage tab).
# You only need to type these yourself if you run against Upstash from your own computer.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
